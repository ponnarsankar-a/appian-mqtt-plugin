<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- =========================================================
       Project identity
       ========================================================= -->
  <groupId>com.example</groupId>
  <artifactId>appian-mqtt-plugin</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Appian MQTT Plugin</name>
  <description>MQTT 3.1.1 Connected System Plug-in for Appian IoT edge connectivity</description>

  <!-- =========================================================
       Global properties
       ========================================================= -->
  <properties>
    <!-- Java version – must match Appian's bundled OpenJDK 17 -->
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!--
      Appian SDK version — update this to match your Appian environment.
      NOTE: This JAR is NOT on Maven Central. See dependency comment below.
    -->
    <appian.sdk.version>26.7</appian.sdk.version>

    <!-- JUnit 5 for unit tests (IS on Maven Central) -->
    <junit.version>5.10.2</junit.version>
  </properties>

  <!-- =========================================================
       Dependencies
       ========================================================= -->
  <dependencies>

    <!--
      ╔══════════════════════════════════════════════════════════╗
      ║  IMPORTANT: Appian Plug-in SDK                          ║
      ║                                                          ║
      ║  The appian-plug-in-sdk JAR is NOT on Maven Central.   ║
      ║  You must obtain it from your Appian installation at:   ║
      ║    <APPIAN_HOME>/_admin/sdk/appian-plug-in-sdk.jar      ║
      ║                                                          ║
      ║  Then copy it to:  libs/appian-plug-in-sdk.jar          ║
      ║  (relative to this pom.xml — create the libs/ folder)  ║
      ║                                                          ║
      ║  OR install it to your local .m2 repo once and use the  ║
      ║  -Plocal-m2 profile (see Profiles section below).       ║
      ║                                                          ║
      ║  scope=system: references the local libs/ JAR directly. ║
      ║  The JAR is NOT bundled into the output — Appian        ║
      ║  provides it at runtime via the _admin/plugins/ loader. ║
      ╚══════════════════════════════════════════════════════════╝
    -->
    <dependency>
      <groupId>com.appian</groupId>
      <artifactId>appian-plug-in-sdk</artifactId>
      <version>${appian.sdk.version}</version>
      <scope>system</scope>
      <!-- Copy the SDK JAR from <APPIAN_HOME>/_admin/sdk/ to this path -->
      <systemPath>${project.basedir}/libs/appian-plug-in-sdk.jar</systemPath>
    </dependency>

    <!-- Eclipse Paho MQTT Client (MQTT 3.1.1) -->
    <dependency>
      <groupId>org.eclipse.paho</groupId>
      <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
      <version>1.2.5</version>
    </dependency>

    <!-- Jackson Databind for JSON filtering and payload handling -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.17.0</version>
    </dependency>

    <!-- Unit testing — available from Maven Central, no manual steps needed -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Mockito for mocking Paho MQTT clients and Appian SDK classes in tests -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.11.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>5.11.0</version>
      <scope>test</scope>
    </dependency>

    <!-- Moquette: embedded MQTT broker for integration tests -->
    <dependency>
      <groupId>io.moquette</groupId>
      <artifactId>moquette-broker</artifactId>
      <version>0.17</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <!-- =========================================================
       Build configuration
       ========================================================= -->
  <build>
    <plugins>

      <!-- Java compiler plugin – enforce Java 17 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.12.1</version>
        <configuration>
          <source>${maven.compiler.source}</source>
          <target>${maven.compiler.target}</target>
          <encoding>${project.build.sourceEncoding}</encoding>
        </configuration>
      </plugin>

      <!-- Maven Shade Plugin - bundle third-party dependencies into plugin JAR -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Maven JAR plugin
        src/main/resources/appian-plugin.xml is automatically placed
        at the JAR root by Maven's resource phase — no extra config needed.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <finalName>${project.artifactId}-${project.version}</finalName>
        </configuration>
      </plugin>

      <!-- Surefire – runs JUnit 5 tests with ./mvnw test -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>

    </plugins>
  </build>

  <!-- =========================================================
       Profiles
       =========================================================

       Profile: local-m2   (for CI/CD or shared environments)
       ─────────────────────────────────────────────────────────
       After installing the SDK JAR into your local .m2 repo:

         ./mvnw install:install-file \
           -Dfile=libs/appian-plug-in-sdk.jar \
           -DgroupId=com.appian \
           -DartifactId=appian-plug-in-sdk \
           -Dversion=26.7 \
           -Dpackaging=jar

       You can then build with the provided scope (better for CI):

         ./mvnw clean package -Plocal-m2

       ========================================================= -->
  <profiles>
    <profile>
      <id>local-m2</id>
      <dependencies>
        <dependency>
          <groupId>com.appian</groupId>
          <artifactId>appian-plug-in-sdk</artifactId>
          <version>${appian.sdk.version}</version>
          <scope>provided</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>

</project>
